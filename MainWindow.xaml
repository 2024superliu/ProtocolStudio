<Window x:Class="WpfProtocolStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:WpfProtocolStudio.ViewModels"
        xmlns:helpers="clr-namespace:WpfProtocolStudio.Helpers"
        mc:Ignorable="d"
        Title="通信与协议双通道中继调试 v2.0"
        Width="1320" Height="800" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA" Foreground="#263244"
        FontFamily="Microsoft YaHei UI" FontSize="12">

    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <helpers:ChannelTypeVisibilityConverter x:Key="ChannelTypeVisibilityConverter"/>
        <helpers:RecordFormatConverter x:Key="RecordFormatConverter"/>
        <helpers:EnumDisplayConverter x:Key="EnumDisplayConverter"/>

        <DataTemplate x:Key="LocalizedEnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}"/>
        </DataTemplate>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F67E8"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4057D5"/>
        <SolidColorBrush x:Key="ChannelABrush" Color="#4169E1"/>
        <SolidColorBrush x:Key="ChannelBBrush" Color="#159A78"/>
        <SolidColorBrush x:Key="TextBrush" Color="#263244"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#718096"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE3EC"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#D6DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B8C3F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E0E7FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChannelAButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource ChannelABrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChannelABrush}"/>
        </Style>

        <Style x:Key="ChannelBButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource ChannelBBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChannelBBrush}"/>
        </Style>

        <Style x:Key="ChannelAStateButton" TargetType="Button" BasedOn="{StaticResource ChannelAButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChannelAOpen}" Value="True">
                    <Setter Property="Background" Value="#E5484D"/>
                    <Setter Property="BorderBrush" Value="#E5484D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChannelBStateButton" TargetType="Button" BasedOn="{StaticResource ChannelBButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChannelBOpen}" Value="True">
                    <Setter Property="Background" Value="#E5484D"/>
                    <Setter Property="BorderBrush" Value="#E5484D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatsResetButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StatsBorder" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StatsBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StatsBorder" Property="Opacity" Value="0.58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#FBFCFE"/>
            <Setter Property="BorderBrush" Value="#CFD8E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="MinHeight" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#FBFCFE"/>
            <Setter Property="BorderBrush" Value="#CFD8E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="MinHeight" Value="3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,11,13,13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F8FAFC"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="10,10,0,0" Padding="13,9">
                                    <ContentPresenter ContentSource="Header"
                                                      TextElement.FontWeight="SemiBold"
                                                      TextElement.FontSize="13"/>
                                </Border>
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderBrush" Value="#EDF1F6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFD"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E6ECFF"/>
                    <Setter Property="Foreground" Value="#243B8F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#F4F7FB"/>
            <Setter Property="Foreground" Value="#66758A"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DataGroupBox" TargetType="GroupBox">
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F3F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 品牌标题与菜单 -->
        <Grid Grid.Row="0">
            <Menu Grid.Row="1" Background="White" Foreground="#344256"
                  BorderBrush="#DCE3EC" BorderThickness="0,0,0,1" Padding="12,3">
                <MenuItem Header="文件(_F)" Padding="10,4">
                    <MenuItem Header="保存日志" Command="{Binding ExportLogCommand}"/>
                    <MenuItem Header="自动保存日志" IsCheckable="True" IsChecked="{Binding IsAutoSaveEnabled}"/>
                    <Separator/>
                    <MenuItem Header="保存通道配置" Command="{Binding SaveConfigCommand}"/>
                    <MenuItem Header="加载通道配置" Command="{Binding LoadConfigCommand}"/>
                </MenuItem>
                <MenuItem Header="设置(_S)" Padding="10,4">
                    <MenuItem Header="选择文件保存文件夹" Command="{Binding SelectReceiveDirectoryCommand}"
                              ToolTip="A-RX 和 B-RX 共用此文件夹，文件名前缀用于区分来源"/>
                    <MenuItem Header="选择日志保存格式">
                        <MenuItem Header="TXT 结构化文本格式 (.txt)" IsCheckable="True" IsChecked="{Binding IsAutoSaveTxt}"/>
                        <MenuItem Header="CSV Excel表格格式 (.csv)" IsCheckable="True" IsChecked="{Binding IsAutoSaveCsv}"/>
                        <MenuItem Header="BIN 结构化二进制格式 (.bin)" IsCheckable="True" IsChecked="{Binding IsAutoSaveBin}"/>
                    </MenuItem>
                    <MenuItem Header="选择自动保存日志文件夹" Command="{Binding SelectAutoSaveLogDirectoryCommand}"/>

                    <Separator/>
                    <MenuItem Header="清空显示记录" Command="{Binding ClearRecordsCommand}"/>
                </MenuItem>
                <MenuItem Header="帮助(_H)" Padding="10,4">
                    <MenuItem Header="关于 Protocol Studio" Command="{Binding ShowAboutCommand}"/>
                </MenuItem>
            </Menu>
        </Grid>

        <!-- 通道配置与全局控制 -->
        <Grid Grid.Row="1" Margin="18,10,18,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- A端通道配置 -->
            <GroupBox Grid.Row="0" Grid.Column="0">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource ChannelABrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="A 端通道" Foreground="{StaticResource ChannelABrush}" FontWeight="Bold"/>
                        <TextBlock Text="  ·  连接配置" Foreground="{StaticResource MutedTextBrush}" FontWeight="Normal"/>
                    </StackPanel>
                </GroupBox.Header>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="类型" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding ChannelTypes}" SelectedItem="{Binding SelectedTypeA}"
                              ItemTemplate="{StaticResource LocalizedEnumItemTemplate}" Width="110" MinHeight="25" Margin="0,2,8,2"/>

                    <WrapPanel Visibility="{Binding SelectedTypeA, Converter={StaticResource ChannelTypeVisibilityConverter}, ConverterParameter='TcpServer'}">
                        <TextBlock Text="监听端口" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PortA, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="0,2,8,2"/>
                    </WrapPanel>

                    <WrapPanel Visibility="{Binding SelectedTypeA, Converter={StaticResource ChannelTypeVisibilityConverter}, ConverterParameter='TcpClient'}">
                        <TextBlock Text="目标 IP" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding IpA, UpdateSourceTrigger=PropertyChanged}" Width="105" Margin="0,2,6,2"/>
                        <TextBlock Text="端口" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PortA, UpdateSourceTrigger=PropertyChanged}" Width="58" Margin="0,2,8,2"/>
                    </WrapPanel>

                    <WrapPanel Visibility="{Binding SelectedTypeA, Converter={StaticResource ChannelTypeVisibilityConverter}, ConverterParameter='Udp'}">
                        <TextBlock Text="本地端口" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LocalPortA, UpdateSourceTrigger=PropertyChanged}" Width="58" Margin="0,2,6,2"/>
                        <TextBlock Text="目标 IP" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding IpA, UpdateSourceTrigger=PropertyChanged}" Width="105" Margin="0,2,6,2"/>
                        <TextBlock Text="端口" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PortA, UpdateSourceTrigger=PropertyChanged}" Width="58" Margin="0,2,8,2"/>
                    </WrapPanel>

                    <WrapPanel Visibility="{Binding SelectedTypeA, Converter={StaticResource ChannelTypeVisibilityConverter}, ConverterParameter='SerialPort'}">
                        <TextBlock Text="COM" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding ComPortA}" Width="68" Margin="0,2,5,2"/>
                        <TextBlock Text="波特率" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableBaudRates}" SelectedItem="{Binding BaudRateA}" Width="78" Margin="0,2,5,2"/>
                        <TextBlock Text="数据位" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableDataBits}" SelectedItem="{Binding DataBitsA}" Width="52" Margin="0,2,5,2"/>
                        <TextBlock Text="停止位" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableStopBits}" SelectedItem="{Binding StopBitsA}"
                                  ItemTemplate="{StaticResource LocalizedEnumItemTemplate}" Width="65" Margin="0,2,5,2"/>
                        <TextBlock Text="校验" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableParities}" SelectedItem="{Binding ParityA}"
                                  ItemTemplate="{StaticResource LocalizedEnumItemTemplate}" Width="78" Margin="0,2,8,2"/>
                    </WrapPanel>

                    <WrapPanel Visibility="{Binding SelectedTypeA, Converter={StaticResource ChannelTypeVisibilityConverter}, ConverterParameter='Can'}">
                        <TextBlock Text="驱动" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CanDriverPathA, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,2,3,2" ToolTip="ControlCAN.dll 文件路径"/>
                        <Button Content="…" Command="{Binding SelectCanDriverACommand}" Width="27" Height="25" Padding="2" Margin="0,2,5,2"/>
                        <TextBlock Text="设备类型" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CanDeviceTypeA, UpdateSourceTrigger=PropertyChanged}" Width="38" Margin="0,2,5,2"/>
                        <TextBlock Text="索引" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CanDeviceIndexA, UpdateSourceTrigger=PropertyChanged}" Width="35" Margin="0,2,5,2"/>
                        <TextBlock Text="通道" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding CanInterfaceOptions}" SelectedItem="{Binding CanInterfaceA}" Width="68" Margin="0,2,5,2"/>
                        <TextBlock Text="波特率" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding CanBaudRateOptions}" SelectedItem="{Binding CanBaudRateA}" Width="85" Margin="0,2,5,2"/>
                        <TextBlock Text="过滤ID" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CanFilterA, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="0,2,8,2" ToolTip="可选：如 0x123"/>
                        <TextBlock Text="发送ID" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CanTransmitIdA, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="0,2,8,2" ToolTip="主动发送及透明转发使用的 CAN ID"/>
                    </WrapPanel>

                    <Button Content="{Binding BtnTextA}" Command="{Binding ToggleChannelACommand}"
                            Style="{StaticResource ChannelAStateButton}" Margin="0,2,8,2" MinWidth="75"/>
                    <Button Content="{Binding StatsTextA}" Command="{Binding ResetChannelAStatisticsCommand}"
                            Style="{StaticResource StatsResetButton}" Background="#EDF2FF"
                            Foreground="{StaticResource ChannelABrush}" Margin="0,2,0,2"
                            ToolTip="点击清零 A 端 RX/TX 统计（不会清空数据记录）"/>
                </WrapPanel>
            </GroupBox>

            <!-- B端通道配置 -->
            <GroupBox Grid.Row="0" Grid.Column="2">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource ChannelBBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="B 端通道" Foreground="{StaticResource ChannelBBrush}" FontWeight="Bold"/>
                        <TextBlock Text="  ·  连接配置" Foreground="{StaticResource MutedTextBrush}" FontWeight="Normal"/>
                    </StackPanel>
                </GroupBox.Header>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="类型" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding ChannelTypes}" SelectedItem="{Binding SelectedTypeB}"
                              ItemTemplate="{StaticResource LocalizedEnumItemTemplate}" Width="110" MinHeight="25" Margin="0,2,8,2"/>

                    <WrapPanel Visibility="{Binding SelectedTypeB, Converter={StaticResource ChannelTypeVisibilityConverter}, ConverterParameter='TcpServer'}">
                        <TextBlock Text="监听端口" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PortB, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="0,2,8,2"/>
                    </WrapPanel>

                    <WrapPanel Visibility="{Binding SelectedTypeB, Converter={StaticResource ChannelTypeVisibilityConverter}, ConverterParameter='TcpClient'}">
                        <TextBlock Text="目标 IP" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding IpB, UpdateSourceTrigger=PropertyChanged}" Width="105" Margin="0,2,6,2"/>
                        <TextBlock Text="端口" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PortB, UpdateSourceTrigger=PropertyChanged}" Width="58" Margin="0,2,8,2"/>
                    </WrapPanel>

                    <WrapPanel Visibility="{Binding SelectedTypeB, Converter={StaticResource ChannelTypeVisibilityConverter}, ConverterParameter='Udp'}">
                        <TextBlock Text="本地端口" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LocalPortB, UpdateSourceTrigger=PropertyChanged}" Width="58" Margin="0,2,6,2"/>
                        <TextBlock Text="目标 IP" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding IpB, UpdateSourceTrigger=PropertyChanged}" Width="105" Margin="0,2,6,2"/>
                        <TextBlock Text="端口" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PortB, UpdateSourceTrigger=PropertyChanged}" Width="58" Margin="0,2,8,2"/>
                    </WrapPanel>

                    <WrapPanel Visibility="{Binding SelectedTypeB, Converter={StaticResource ChannelTypeVisibilityConverter}, ConverterParameter='SerialPort'}">
                        <TextBlock Text="COM" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding ComPortB}" Width="68" Margin="0,2,5,2"/>
                        <TextBlock Text="波特率" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableBaudRates}" SelectedItem="{Binding BaudRateB}" Width="78" Margin="0,2,5,2"/>
                        <TextBlock Text="数据位" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableDataBits}" SelectedItem="{Binding DataBitsB}" Width="52" Margin="0,2,5,2"/>
                        <TextBlock Text="停止位" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableStopBits}" SelectedItem="{Binding StopBitsB}"
                                  ItemTemplate="{StaticResource LocalizedEnumItemTemplate}" Width="65" Margin="0,2,5,2"/>
                        <TextBlock Text="校验" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableParities}" SelectedItem="{Binding ParityB}"
                                  ItemTemplate="{StaticResource LocalizedEnumItemTemplate}" Width="78" Margin="0,2,8,2"/>
                    </WrapPanel>

                    <WrapPanel Visibility="{Binding SelectedTypeB, Converter={StaticResource ChannelTypeVisibilityConverter}, ConverterParameter='Can'}">
                        <TextBlock Text="驱动" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CanDriverPathB, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,2,3,2" ToolTip="ControlCAN.dll 文件路径"/>
                        <Button Content="…" Command="{Binding SelectCanDriverBCommand}" Width="27" Height="25" Padding="2" Margin="0,2,5,2"/>
                        <TextBlock Text="设备类型" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CanDeviceTypeB, UpdateSourceTrigger=PropertyChanged}" Width="38" Margin="0,2,5,2"/>
                        <TextBlock Text="索引" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CanDeviceIndexB, UpdateSourceTrigger=PropertyChanged}" Width="35" Margin="0,2,5,2"/>
                        <TextBlock Text="通道" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding CanInterfaceOptions}" SelectedItem="{Binding CanInterfaceB}" Width="68" Margin="0,2,5,2"/>
                        <TextBlock Text="波特率" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding CanBaudRateOptions}" SelectedItem="{Binding CanBaudRateB}" Width="85" Margin="0,2,5,2"/>
                        <TextBlock Text="过滤ID" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CanFilterB, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="0,2,8,2" ToolTip="可选：如 0x123"/>
                        <TextBlock Text="发送ID" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CanTransmitIdB, UpdateSourceTrigger=PropertyChanged}" Width="65" Margin="0,2,8,2" ToolTip="主动发送及透明转发使用的 CAN ID"/>
                    </WrapPanel>

                    <Button Content="{Binding BtnTextB}" Command="{Binding ToggleChannelBCommand}"
                            Style="{StaticResource ChannelBStateButton}" Margin="0,2,8,2" MinWidth="75"/>
                    <Button Content="{Binding StatsTextB}" Command="{Binding ResetChannelBStatisticsCommand}"
                            Style="{StaticResource StatsResetButton}" Background="#EAF8F4"
                            Foreground="{StaticResource ChannelBBrush}" Margin="0,2,0,2"
                            ToolTip="点击清零 B 端 RX/TX 统计（不会清空数据记录）"/>
                </WrapPanel>
            </GroupBox>

            <!-- 中间控制与检索工具栏 -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="15,6">
                <Grid>
