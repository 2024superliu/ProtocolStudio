                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Consolas" Foreground="#3559CE" TextWrapping="NoWrap">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource RecordFormatConverter}">
                                                            <Binding/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Grid.Column="0" Style="{StaticResource DataGroupBox}">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="A · TX" Foreground="{StaticResource ChannelABrush}" Style="{StaticResource PanelHeader}"/>
                                <TextBlock Text="  发送数据" Foreground="{StaticResource MutedTextBrush}" FontWeight="Normal"/>
