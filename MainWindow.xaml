                    </GroupBox>

                    <GroupBox Grid.Row="0" Grid.Column="2" Style="{StaticResource DataGroupBox}">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="B · RX" Foreground="{StaticResource ChannelBBrush}" Style="{StaticResource PanelHeader}"/>
                                <TextBlock Text="  接收数据" Foreground="{StaticResource MutedTextBrush}" FontWeight="Normal"/>
                                <CheckBox Content="保存B-RX日志" IsChecked="{Binding SaveBRxLog}" Margin="10,0,8,0"/>
                                <CheckBox Content="保存B-RX文件" IsChecked="{Binding SaveBRxFile}" Margin="10,0,8,0"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <ListView ItemsSource="{Binding ChannelBRxRecords}" AlternationCount="2"
                          helpers:AutoScrollHelper.AutoScroll="True"
                          helpers:GridViewColumnResizeBehavior.IsEnabled="True"
                          helpers:GridViewColumnResizeBehavior.ColumnWeights="2,1,8"
                          helpers:GridViewColumnResizeBehavior.MinimumWidths="86,48,160"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecksumValid}" Value="True">
                                            <Setter Property="Background" Value="#EAF8F0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecksumValid}" Value="False">
                                            <Setter Property="Background" Value="#FDECEC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="时间" DisplayMemberBinding="{Binding TimeString}"/>
                                    <GridViewColumn Header="长度" DisplayMemberBinding="{Binding Length}"/>
                                    <GridViewColumn Header="{Binding DataContext.SelectDisplayFormat, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumDisplayConverter}, ConverterParameter=DataHeader}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Consolas" Foreground="#138568" TextWrapping="NoWrap">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource RecordFormatConverter}">
                                                            <Binding/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Grid.Column="2" Style="{StaticResource DataGroupBox}">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="B · TX" Foreground="{StaticResource ChannelBBrush}" Style="{StaticResource PanelHeader}"/>
                                <TextBlock Text="  发送数据" Foreground="{StaticResource MutedTextBrush}" FontWeight="Normal"/>
                                <CheckBox Content="保存B-TX日志" IsChecked="{Binding SaveBTxLog}" Margin="10,0,8,0"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <ListView ItemsSource="{Binding ChannelBTxRecords}" AlternationCount="2"
                          helpers:AutoScrollHelper.AutoScroll="True"
                          helpers:GridViewColumnResizeBehavior.IsEnabled="True"
                          helpers:GridViewColumnResizeBehavior.ColumnWeights="2,2,1,7"
                          helpers:GridViewColumnResizeBehavior.MinimumWidths="86,82,48,140"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="时间" DisplayMemberBinding="{Binding TimeString}"/>
                                    <GridViewColumn Header="来源 / 备注" DisplayMemberBinding="{Binding Description}"/>
                                    <GridViewColumn Header="长度" DisplayMemberBinding="{Binding Length}"/>
                                    <GridViewColumn Header="{Binding DataContext.SelectDisplayFormat, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumDisplayConverter}, ConverterParameter=DataHeader}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Consolas" Foreground="#138568" TextWrapping="NoWrap">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource RecordFormatConverter}">
                                                            <Binding/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="历史数据">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="选择日志文件" Command="{Binding SelectHistoryLogFilesCommand}"
                                    Padding="11,4" MinHeight="28" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding HistoryFileSummary}" IsReadOnly="True"
                                     ToolTip="{Binding HistoryFileSummary}" Height="28" Margin="0,0,14,0"/>
                            <TextBlock Grid.Column="2" Text="关键字" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="3" Text="{Binding HistoryKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Margin="0,0,8,0"
                                     ToolTip="支持 HEX（可省略空格）、ASCII、二进制、时间、方向、备注和文件名"/>
                            <Button Grid.Column="4" Content="{Binding HistorySearchButtonText}" Command="{Binding SearchHistoryCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="14,4" MinHeight="28" Margin="0,0,6,0"/>
                            <Button Grid.Column="5" Content="清空结果" Command="{Binding ClearHistorySearchCommand}"
                                    Padding="11,4" MinHeight="28"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding HistorySearchResults}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              Background="White" AlternatingRowBackground="#FAFBFD"
                              RowBackground="White" HorizontalGridLinesBrush="#EDF1F6"
                              SelectionMode="Extended" ClipboardCopyMode="IncludeHeader">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F4F7FB"/>
                                <Setter Property="Foreground" Value="#66758A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,7"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="150"/>
                            <DataGridTextColumn Header="时间 / 偏移" Binding="{Binding TimestampText}" Width="165"/>
                            <DataGridTextColumn Header="方向" Binding="{Binding DirectionText}" Width="70"/>
                            <DataGridTextColumn Header="所属端" Binding="{Binding EndpointText}" Width="70"/>
                            <DataGridTextColumn Header="长度" Binding="{Binding Length}" Width="65"/>
                            <DataGridTextColumn Header="HEX 内容" Binding="{Binding HexContent}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding HexContent}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ASCII 内容" Binding="{Binding AsciiContent}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding AsciiContent}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="备注" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,1,1" Padding="10,6">
                        <TextBlock Text="{Binding HistorySearchStatus}" Foreground="{StaticResource MutedTextBrush}"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="协议辅助">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Center" Width="1284">
                    <StackPanel>
                        <GroupBox Header="数据流分帧显示" Margin="0,0,0,10">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Text="分帧方式" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding FrameModes}" SelectedItem="{Binding SelectedFrameMode}"
                                              ItemTemplate="{StaticResource LocalizedEnumItemTemplate}" Width="175" Margin="0,0,14,0"/>

                                    <TextBlock Text="固定长度" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding FrameFixedLength}" Width="75" Margin="0,0,4,0"/>
                                    <TextBlock Text="字节" Margin="0,0,14,0"/>

                                    <TextBlock Text="分隔符" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding FrameDelimiterText}" Width="145" Margin="0,0,6,0"
                                             FontFamily="Consolas" ToolTip="HEX示例：0D 0A；文本模式可输入任意UTF-8文本"/>
                                    <RadioButton Content="HEX" IsChecked="{Binding IsFrameDelimiterHex}" Margin="0,0,7,0"/>
                                    <RadioButton Content="文本" IsChecked="{Binding IsFrameDelimiterText}" Margin="0,0,14,0"/>

                                    <TextBlock Text="空闲间隔" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding FrameIdleMilliseconds}" Width="75" Margin="0,0,4,0"/>
                                    <TextBlock Text="ms"/>
                                </WrapPanel>
                                <Border Background="#F4F7FB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7">
                                    <TextBlock Text="{Binding FrameConfigurationStatus}" Foreground="#334155" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0" Header="CRC校验计算">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="95"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <WrapPanel Grid.Row="0" Margin="0,0,0,7">
                                        <TextBlock Text="算法" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding ChecksumAlgorithms}" SelectedItem="{Binding SelectedChecksumAlgorithm}"
                                                  ItemTemplate="{StaticResource LocalizedEnumItemTemplate}" Width="190" Margin="0,0,12,0"/>
                                        <RadioButton Content="HEX输入" VerticalAlignment="Center" IsChecked="{Binding IsChecksumInputHex}" Margin="0,0,8,0"/>
                                        <RadioButton Content="文本输入" VerticalAlignment="Center" IsChecked="{Binding IsChecksumInputText}"/>
                                    </WrapPanel>
                                    <TextBox Grid.Row="1" Text="{Binding ChecksumInput, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" Padding="6"/>
                                    <WrapPanel Grid.Row="2" Margin="0,8,0,7">
                                        <Button Content="计算校验值" Command="{Binding CalculateChecksumCommand}"
                                                Style="{StaticResource PrimaryButton}" Margin="0,0,7,0"/>
                                        <Button Content="验证报文末尾" Command="{Binding VerifyChecksumCommand}"
                                                Padding="10,4" ToolTip="HEX输入完整报文，自动核对末尾2字节或4字节校验值"/>
                                    </WrapPanel>
                                    <Border Grid.Row="3" Background="#F4F7FB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ChecksumResult}" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#3046A5" TextWrapping="Wrap"/>
                                            <Separator Margin="0,7"/>
                                            <WrapPanel>
                                                <CheckBox Content="自动校验接收CRC" IsChecked="{Binding IsAutoReceiveChecksumEnabled}"
                                                          FontWeight="SemiBold" Foreground="#138568" Margin="0,0,10,0"/>
                                                <TextBlock Text="算法" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox ItemsSource="{Binding ChecksumAlgorithms}" SelectedItem="{Binding SelectedReceiveChecksumAlgorithm}"
                                                          ItemTemplate="{StaticResource LocalizedEnumItemTemplate}" Width="178" Margin="0,0,10,0"/>
                                                <CheckBox Content="高字节在前" IsChecked="{Binding IsReceiveChecksumHighByteFirst}"
                                                          Margin="0,0,10,0" ToolTip="勾选：47 34；不勾选：34 47。标准Modbus RTU通常不勾选。"/>
                                                <CheckBox Content="丢弃错误帧（显示/解析）" IsChecked="{Binding HideInvalidChecksumFrames}"
                                                          Foreground="#D9364F" Margin="0,0,10,0"/>
                                                <Button Content="重置计数" Command="{Binding ResetCrcValidationStatisticsCommand}" Padding="8,2"/>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding CrcValidationSummary}" Margin="0,6,0,0" FontWeight="SemiBold"/>
                                            <TextBlock Text="仅验证A-RX/B-RX的完整分帧；隐藏错误帧只影响界面和协议解析，不改变透明转发与原始日志。"
                                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <GroupBox Grid.Column="2" Header="协议解析插件">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="75"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="150"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <WrapPanel Grid.Row="0" Margin="0,0,0,5">
                                        <TextBlock Text="解析器" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding ProtocolParsers}" SelectedItem="{Binding SelectedProtocolParser}"
                                                  DisplayMemberPath="Name" Width="190" Margin="0,0,8,0"/>
                                        <Button Content="重新加载插件" Command="{Binding ReloadProtocolPluginsCommand}" MinHeight="27" Padding="9,3"/>
                                        <Button Content="打开插件目录" Command="{Binding OpenProtocolPluginFolderCommand}"
                                                MinHeight="27" Padding="9,3" Margin="6,0,0,0"/>
                                        <CheckBox Content="实时解析" IsChecked="{Binding IsRealtimeProtocolParsingEnabled}"
                                                  VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="#138568"/>
                                    </WrapPanel>
                                    <Border Grid.Row="1" Background="#F4F7FB" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="7,4" Margin="0,0,0,5">
                                        <TextBlock Text="{Binding ProtocolPluginStatus}" Foreground="#52637A" TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="{Binding SelectedProtocolParserDescription}" Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBox Grid.Row="3" Text="{Binding ProtocolInput, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" Padding="6"/>
                                    <WrapPanel Grid.Row="4" Margin="0,7,0,7">
                                        <RadioButton Content="HEX输入" IsChecked="{Binding IsProtocolInputHex}" Margin="0,0,8,0"/>
                                        <RadioButton Content="文本输入" IsChecked="{Binding IsProtocolInputText}" Margin="0,0,12,0"/>
                                        <Button Content="解析数据" Command="{Binding ParseProtocolCommand}" Style="{StaticResource PrimaryButton}" MinHeight="27" Padding="12,3"/>
                                    </WrapPanel>
                                    <TextBox Grid.Row="5" Text="{Binding ProtocolParseOutput}" IsReadOnly="True"
                                             FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             MinHeight="70" Padding="7" Background="#F8FAFC"/>
                                    <DockPanel Grid.Row="6" Margin="0,7,0,5">
                                        <TextBlock Text="实时解析结果（来自分帧后的数据）" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Content="清空" Command="{Binding ClearRealtimeProtocolResultsCommand}"
                                                DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="9,2"/>
                                    </DockPanel>
                                    <DataGrid Grid.Row="7" ItemsSource="{Binding RealtimeProtocolResults}" AutoGenerateColumns="False"
                                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="时间" Binding="{Binding TimeString}" Width="92"/>
                                            <DataGridTextColumn Header="方向" Binding="{Binding DirectionText}" Width="67"/>
                                            <DataGridTextColumn Header="解析器" Binding="{Binding ParserName}" Width="110"/>
                                            <DataGridTextColumn Header="解析结果" Binding="{Binding DisplayText}"
                                                                Width="SizeToCells" MinWidth="360">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="{Binding RawHex}"/>
                                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                                        <Setter Property="TextTrimming" Value="None"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Grid.Row="8" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding RealtimeProtocolStatus}" Foreground="#138568" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 发送区 -->
        <Border Grid.Row="3" Margin="18,0,18,12" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="发送至" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" Margin="0,0,9,0"/>
                        <RadioButton Content="A 端" IsChecked="{Binding SendToA}" Margin="0,0,11,0" FontWeight="SemiBold"/>
                        <RadioButton Content="B 端" IsChecked="{Binding SendToA, Converter={StaticResource InverseBoolConverter}, FallbackValue=False}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="循环发送" IsChecked="{Binding IsAutoSend}" Foreground="#C67A13" FontWeight="SemiBold" Margin="0,0,9,0"/>
                        <TextBlock Text="周期" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding AutoSendIntervalMs, UpdateSourceTrigger=PropertyChanged}" Width="66" Padding="6,4"/>
                        <TextBlock Text="ms" Foreground="{StaticResource MutedTextBrush}" Margin="5,0,0,0"/>
                        <TextBlock Text="次数" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Margin="9,0,5,0"/>
                        <TextBox Text="{Binding AutoSendCount, UpdateSourceTrigger=PropertyChanged}" Width="52" Padding="6,4" ToolTip="0 表示无限循环"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SendStatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding FileTransferStatus}" Foreground="#138568" FontSize="11"
                                   Margin="14,0,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FileTransferStatus}"/>
                    </Grid>
                    <TextBox Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="13" AcceptsReturn="True" Height="35"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="5,4"
                             ToolTip="输入需要发送的 HEX 或 ASCII 数据"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Content="{Binding SendBtnText}" Command="{Binding SendDataCommand}"
                            Style="{StaticResource PrimaryButton}" Width="100" Height="32" FontSize="13"/>
                    <Button Content="{Binding FileSendButtonText}" Command="{Binding SendFileCommand}"
                            Width="100" Height="27" Margin="0,5,0,0" FontSize="12"
                            ToolTip="发送带文件名和 SHA-256 校验的完整文件；接收端需运行本工具"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,10,0">
                    <!-- 上层：发送模式 (Hex / ASCII) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="发送模式" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                        <RadioButton Content="Hex" IsChecked="{Binding IsSendHex}" Foreground="#C67A13" FontWeight="SemiBold" Margin="8,0,9,0"/>
                        <RadioButton Content="ASCII" IsChecked="{Binding IsSendAscii}" Foreground="#C67A13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <!-- 下层：常用模板区 -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="常用模板" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding QuickTemplates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" Width="140" Height="26" Margin="6,0,6,0" VerticalAlignment="Center"/>
                        <Button Content="+ 存模板" Command="{Binding AddTemplateCommand}" Padding="6,2" Height="26" VerticalAlignment="Center"/>
                        <Button Content="删除" Command="{Binding DeleteTemplateCommand}" Padding="6,2" Height="26" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="删除当前选中的报文模板"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="4" Background="#E9EEF5" BorderBrush="#D8E0EA" BorderThickness="0,1,0,0" Padding="12,4">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Border Width="7" Height="7" CornerRadius="4" Background="#43B581" Margin="0,0,7,0"/>
                    <TextBlock Text="就绪" Foreground="#607086" FontWeight="SemiBold"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Margin="7,0"/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusTextA}" Foreground="{StaticResource ChannelABrush}" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator Margin="7,0"/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusTextB}" Foreground="{StaticResource ChannelBBrush}" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator Margin="7,0"/>
            <StatusBarItem>
                <TextBlock Text="{Binding ForwardingStatusText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator Margin="7,0"/>
            <StatusBarItem>
                <TextBlock Text="{Binding CrcValidationSummary}" FontWeight="SemiBold" Foreground="#52637A"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
