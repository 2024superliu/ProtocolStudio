                            </StackPanel>
                        </GroupBox.Header>
                        <ListView ItemsSource="{Binding ChannelATxRecords}" AlternationCount="2"
                          helpers:AutoScrollHelper.AutoScroll="True"
                          helpers:GridViewColumnResizeBehavior.IsEnabled="True"
                          helpers:GridViewColumnResizeBehavior.ColumnWeights="2,2,1,7"
                          helpers:GridViewColumnResizeBehavior.MinimumWidths="86,82,48,140"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="时间" DisplayMemberBinding="{Binding TimeString}"/>
                                    <GridViewColumn Header="来源 / 备注" DisplayMemberBinding="{Binding Description}"/>
                                    <GridViewColumn Header="长度" DisplayMemberBinding="{Binding Length}"/>
                                    <GridViewColumn Header="{Binding DataContext.SelectDisplayFormat, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumDisplayConverter}, ConverterParameter=DataHeader}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Consolas" Foreground="#3559CE" TextWrapping="NoWrap">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource RecordFormatConverter}">
